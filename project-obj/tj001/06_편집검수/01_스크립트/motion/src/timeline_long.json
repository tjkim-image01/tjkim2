 "lines": [
  {
   "part": "P0",
   "shot": "P0-I1",
   "who": "하린",
   "text": "야, 책상 위에 이게 다 엽서야? 몇 장이야 이게?",
   "sub": "이게 다 엽서야? 몇 장이야?",
   "start": 0.8,
   "end": 4.6,
   "words": []
  },
  {
   "part": "P0",
   "shot": "P0-I1",
   "who": "태진",
   "text": "천 장 넘어. 근데 오늘은 딱 한 장만 보여 줄게. 내가 가진 것 중에 제일 이상한 엽서.",
   "sub": "1,000장 넘어. 오늘은 딱 한 장 — 제일 이상한 엽서",
   "start": 4.84,
   "end": 10.49,
   "words": []
  },
  {
   "part": "P0",
   "shot": "P0-I2",
   "who": "하린",
   "text": "어, 이거 임금님 아니야? 한복 입은.",
   "sub": "이거 임금님 아니야?",
   "start": 10.91,
   "end": 13.26,
   "words": []
  },
  {
   "part": "P0",
   "shot": "P0-I2",
   "who": "태진",
   "text": "대한제국 황제. 천구백 년쯤 거. 근데 뒷면 봐. 포스트 카드, 재팬. 그리고 비매품.",
   "sub": "대한제국 황제 · 1900년경 / 뒷면: POST CARD, JAPAN · 비매품",
   "start": 13.5,
   "end": 19.8,
   "words": []
  },
  {
   "part": "P0",
   "shot": "P0-I3",
   "who": "하린",
   "text": "잠깐, 우리 황제 얼굴을 일본에서 엽서로 찍었다고? 그것도 공짜로 뿌렸다고?",
   "sub": "황제 얼굴을 일본에서 엽서로? 공짜로?",
   "start": 20.22,
   "end": 25.47,
   "words": []
  },
  {
   "part": "P0",
   "shot": "P0-I3",
   "who": "태진",
   "text": "그게 왜 그렇게 됐는지 알려면, 천팔백육십오 년 독일 우체국부터 가야 돼.",
   "sub": "그 이유는 1865년 독일 우체국에서 시작",
   "start": 25.71,
   "end": 30.86,
   "words": []
  },
  {
   "part": "P1",
   "shot": "P1-A1",
   "who": "태진",
   "text": "천팔백육십오 년, 독일 우편 관리 슈테판이 제안을 해. 편지를 봉투 없이 보내자.",
   "sub": "1865 · 슈테판: \"봉투 없이 보내자\"",
   "start": 32.76,
   "end": 38.61,
   "words": []
  },
  {
   "part": "P1",
   "shot": "P1-A1",
   "who": "하린",
   "text": "오, 싸고 편하겠네. 당연히 통과?",
   "sub": "싸고 편하네. 통과?",
   "start": 38.85,
   "end": 41.2,
   "words": []
  },
  {
   "part": "P1",
   "shot": "P1-A2",
   "who": "태진",
   "text": "거절. 이유가 뭐였게?",
   "sub": "거절. 이유는?",
   "start": 41.62,
   "end": 43.67,
   "words": []
  },
  {
   "part": "P1",
   "shot": "P1-A2",
   "who": "하린",
   "text": "음, 종이 낭비?",
   "sub": "종이 낭비?",
   "start": 43.91,
   "end": 45.16,
   "words": []
  },
  {
   "part": "P1",
   "shot": "P1-A2",
   "who": "태진",
   "text": "아니. 남이 읽는다. 사적인 글을 남들이 다 본다, 품위가 없다.",
   "sub": "\"남이 읽는다\" — 품위가 없다",
   "start": 45.4,
   "end": 50.35,
   "words": []
  },
  {
   "part": "P1",
   "shot": "P1-A3",
   "who": "하린",
   "text": "아 뭐야, 그거 완전 인스타 스토리잖아. 남 보라고 올리는 건데.",
   "sub": "완전 인스타 스토리잖아!",
   "start": 50.77,
   "end": 54.92,
   "words": []
  },
  {
   "part": "P1",
   "shot": "P1-A3",
   "who": "태진",
   "text": "그치. 근데 사 년 뒤 오스트리아가 받아 줘. 천팔백육십구 년 시월 일 일, 세계 최초의 엽서. 그림도 없는 누런 종이였는데 석 달 만에 삼백만 장.",
   "sub": "1869. 10. 1 오스트리아, 세계 최초 엽서 / 석 달 만에 300만 장",
   "start": 55.16,
   "end": 67.26,
   "words": []
  },
  {
   "part": "P2",
   "shot": "P2-B1",
   "who": "하린",
   "text": "삼백만? 왜 그렇게 잘 팔렸어?",
   "sub": "왜 그렇게 잘 팔렸어?",
   "start": 69.16,
   "end": 71.26,
   "words": []
  },
  {
   "part": "P2",
   "shot": "P2-B1",
   "who": "태진",
   "text": "싸고, 빠르고, 짧으니까. 그리고 여기에 사진이 올라타.",
   "sub": "싸다 · 빠르다 · 짧다 + 사진",
   "start": 71.5,
   "end": 76.1,
   "words": []
  },
  {
   "part": "P2",
   "shot": "P2-B2",
   "who": "태진",
   "text": "이거 봐. 천구백 년 파리 만국박람회 엽서. 서른다섯 장이 세트로 있어.",
   "sub": "1900 파리 만국박람회 엽서 35장 세트",
   "start": 76.52,
   "end": 82.97,
   "words": []
  },
  {
   "part": "P2",
   "shot": "P2-B2",
   "who": "하린",
   "text": "에펠탑! 와, 색이 아직도 이렇게 선명해?",
   "sub": "에펠탑! 색이 아직도 선명해",
   "start": 83.21,
   "end": 86.26,
   "words": []
  },
  {
   "part": "P2",
   "shot": "P2-B3",
   "who": "태진",
   "text": "천구백오 년 한 해에 전 세계에서 칠십억 장이 오갔어. 집집마다 엽서 앨범이 있었대.",
   "sub": "1905년 한 해 70억 장 / 집집마다 엽서 앨범",
   "start": 86.68,
   "end": 93.03,
   "words": []
  },
  {
   "part": "P2",
   "shot": "P2-B3",
   "who": "하린",
   "text": "그게 요즘 폰 사진첩이네.",
   "sub": "요즘 폰 사진첩이네",
   "start": 93.27,
   "end": 95.17,
   "words": []
  },
  {
   "part": "P2",
   "shot": "P2-B3",
   "who": "태진",
   "text": "천구백칠 년엔 뒷면을 반으로 갈라서 왼쪽에 글, 오른쪽에 주소. 그래서 앞면이 통째로 사진이 된 거야.",
   "sub": "1907 뒷면 분할 → 앞면 전체가 사진",
   "start": 95.41,
   "end": 102.51,
   "words": []
  },
  {
   "part": "P3",
   "shot": "P3-C1",
   "who": "하린",
   "text": "그럼 조선은? 우리도 엽서 있었어?",
   "sub": "조선은? 우리도 있었어?",
   "start": 104.41,
   "end": 106.66,
   "words": []
  },
  {
   "part": "P3",
   "shot": "P3-C1",
   "who": "태진",
   "text": "천팔백팔십사 년에 우표부터 냈는데, 갑신정변 터져서 이십일 일 만에 끝.",
   "sub": "1884 우표 → 갑신정변, 21일 만에 중단",
   "start": 106.9,
   "end": 112.45,
   "words": []
  },
  {
   "part": "P3",
   "shot": "P3-C1",
   "who": "하린",
   "text": "이십일 일?",
   "sub": "21일?",
   "start": 112.69,
   "end": 113.54,
   "words": []
  },
  {
   "part": "P3",
   "shot": "P3-C2",
   "who": "태진",
   "text": "그리고 천구백 년 오월 십 일. 대한제국이 일 전짜리 우체엽서를 내. 오얏꽃 찍힌 거.",
   "sub": "1900. 5. 10 대한제국 1전 우체엽서 · 오얏꽃",
   "start": 113.96,
   "end": 119.76,
   "words": []
  },
  {
   "part": "P3",
   "shot": "P3-C2",
   "who": "태진",
   "text": "근데 양반들이 안 썼대. 이유가 뭐였게?",
   "sub": "양반은 안 썼다. 이유는?",
   "start": 120.0,
   "end": 122.5,
   "words": []
  },
  {
   "part": "P3",
   "shot": "P3-C2",
   "who": "하린",
   "text": "설마, 남이 읽는다?",
   "sub": "설마… \"남이 읽는다\"?",
   "start": 122.74,
   "end": 124.29,
   "words": []
  },
  {
   "part": "P3",
   "shot": "P3-C3",
   "who": "태진",
   "text": "정답. 천팔백육십오 년이랑 똑같아. 대신 먼저 쓴 건 상인이랑 서민. 싸고 빠른 게 더 급한 사람들.",
   "sub": "정답! 1865 = 1900 / 먼저 쓴 사람: 상인 · 서민",
   "start": 124.71,
   "end": 131.66,
   "words": []
  },
  {
   "part": "P3",
   "shot": "P3-C4",
   "who": "태진",
   "text": "그리고 같은 해 파리 박람회 한국관에서 한국 최초의 사진엽서가 팔려. 프랑스어 교사 알레베크가 찍은 궁궐이랑 거리, 마흔여덟 장.",
   "sub": "1900 파리 한국관 · 알레베크 사진엽서 48장",
   "start": 132.08,
   "end": 141.63,
   "words": []
  },
  {
   "part": "P3",
   "shot": "P3-C4",
   "who": "하린",
   "text": "그래서 아까 그 황제 엽서도 그 즈음이구나.",
   "sub": "황제 엽서도 그 즈음",
   "start": 141.87,
   "end": 144.97,
   "words": []
  },
  {
   "part": "P4",
   "shot": "P4-D1",
   "who": "태진",
   "text": "천구백십 년 지나면 분위기가 바뀌어. 이거 봐, 봉투에 열 장. 조선풍속.",
   "sub": "1910 → '조선풍속' 세트, 봉투에 10장",
   "start": 146.87,
   "end": 152.22,
   "words": []
  },
  {
   "part": "P4",
   "shot": "P4-D1",
   "who": "하린",
   "text": "기생, 지게꾼, 빨래터, 관광 기념품 같은데?",
   "sub": "관광 기념품 같은데?",
   "start": 152.46,
   "end": 155.71,
   "words": []
  },
  {
   "part": "P4",
   "shot": "P4-D2",
   "who": "태진",
   "text": "맞아. 대부분 일본에서 찍어서 팔았어. 내 컬렉션 제목에만 조선풍속이 쉰아홉 번 나와. 경성 마흔네 번, 금강산 서른두 번.",
   "sub": "조선풍속 59 · 경성 44 · 금강산 32",
   "start": 156.13,
   "end": 164.83,
   "words": []
  },
  {
   "part": "P4",
   "shot": "P4-D2",
   "who": "하린",
   "text": "그럼 이 사진들, 조선 사람이 찍은 게 아니네.",
   "sub": "조선 사람이 찍은 게 아니네",
   "start": 165.07,
   "end": 167.77,
   "words": []
  },
  {
   "part": "P4",
   "shot": "P4-D3",
   "who": "태진",
   "text": "연구자들은 두 시선이 겹쳐 있다고 봐. 조선을 구경거리로 본 시선, 그리고 그 안에서 제 모습을 지키려 한 사람들의 시선.",
   "sub": "연구자 견해: 두 시선이 겹친다 — 구경거리로 본 시선 / 제 모습을 지키려는 시선",
   "start": 168.19,
   "end": 175.89,
   "words": []
  },
  {
   "part": "P4",
   "shot": "P4-D3",
   "who": "하린",
   "text": "그래서 황제 얼굴도 비매품으로 뿌린 거구나. 구경거리처럼.",
   "sub": "그래서 황제 얼굴도 '비매품'",
   "start": 176.13,
   "end": 179.93,
   "words": []
  },
  {
   "part": "P5",
   "shot": "P5-E1",
   "who": "태진",
   "text": "근데 엽서는 진짜 재밌는 게 뒷면이야. 이거, 금강산 장안사 엽서. 뒤집어 봐.",
   "sub": "진짜 재미는 뒷면 — 뒤집어 봐",
   "start": 181.83,
   "end": 186.88,
   "words": []
  },
  {
   "part": "P5",
   "shot": "P5-E1",
   "who": "하린",
   "text": "우표 있고, 도장 찍혀 있고, 진짜 누가 보낸 거야?",
   "sub": "우표 · 소인 · 손글씨, 진짜 보낸 거야?",
   "start": 187.12,
   "end": 190.82,
   "words": []
  },
  {
   "part": "P5",
   "shot": "P5-E2",
   "who": "태진",
