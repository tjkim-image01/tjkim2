 "lines": [
  {
   "part": "X0",
   "shot": "X0-I1",
   "who": "옥자",
   "emo": "일반",
   "text": "태진아, 삐라 전에도 이런 게 있었어?",
   "sub": "삐라 전에도 있었어?",
   "start": 0.8,
   "end": 4.05,
   "words": []
  },
  {
   "part": "X0",
   "shot": "X0-I1",
   "who": "태진",
   "emo": "기쁨",
   "text": "있죠. 오늘은 백 년을 한 번에 갈게요. 종이 한 장으로 사람 마음을 움직이는 법이 어떻게 바뀌었는지.",
   "sub": "100년을 한 번에 — 종이로 마음을 움직이는 법",
   "start": 4.29,
   "end": 12.14,
   "words": []
  },
  {
   "part": "X1",
   "shot": "X1-A1",
   "who": "태진",
   "emo": "일반",
   "text": "첫 장은 판화예요. 청일전쟁 때 일본에서 찍은 전쟁 판화, 니시키에. 세 장을 이어 붙인 그림이에요.",
   "sub": "청일전쟁 · 일본 전쟁 판화(錦絵) / 세 장을 이어 붙인 그림",
   "start": 14.04,
   "end": 20.69,
   "words": []
  },
  {
   "part": "X1",
   "shot": "X1-A1",
   "who": "옥자",
   "emo": "높은 톤",
   "text": "그림이 엄청 화려하네. 말 탄 군인들에 깃발에.",
   "sub": "엄청 화려하네!",
   "start": 20.93,
   "end": 25.63,
   "words": []
  },
  {
   "part": "X1",
   "shot": "X1-A2",
   "who": "태진",
   "emo": "일반",
   "text": "사진이 귀하던 때라, 사람들이 이런 판화를 사서 전쟁 소식을 봤어요. 실제보다 훨씬 멋있게 그렸죠.",
   "sub": "사진 대신 판화로 전쟁 소식 / 실제보다 멋있게",
   "start": 26.05,
   "end": 32.35,
   "words": []
  },
  {
   "part": "X1",
   "shot": "X1-A2",
   "who": "옥자",
   "emo": "기쁨",
   "text": "보도사진이 아니라 홍보 포스터네.",
   "sub": "보도가 아니라 홍보",
   "start": 32.59,
   "end": 35.44,
   "words": []
  },
  {
   "part": "X1",
   "shot": "X1-A3",
   "who": "태진",
   "emo": "낮은 톤",
   "text": "그리고 그 판화 속 무대가 조선이에요. 남의 나라 전쟁터가 된 우리 땅을 그렇게 그려서 팔았어요.",
   "sub": "판화 속 무대 = 조선 / 남의 전쟁터가 된 우리 땅",
   "start": 35.86,
   "end": 43.16,
   "words": []
  },
  {
   "part": "X2",
   "shot": "X2-B1",
   "who": "태진",
   "emo": "일반",
   "text": "오십 년쯤 뒤, 천구백사십삼 년 미국. 이즈 유어 트립 네세서리? 그 여행 꼭 가야 합니까? 쓸데없는 여행은 전쟁을 방해한다.",
   "sub": "1943 미국 / \"Is Your Trip Necessary?\" — 쓸데없는 여행은 전쟁을 방해한다",
   "start": 45.06,
   "end": 53.71,
   "words": []
  },
  {
   "part": "X2",
   "shot": "X2-B1",
   "who": "옥자",
   "emo": "기쁨",
   "text": "꽉 찬 기차 사진이네. 명절 귀성길이구먼.",
   "sub": "꽉 찬 기차 = 명절 귀성길",
   "start": 53.95,
   "end": 58.05,
   "words": []
  },
  {
   "part": "X2",
   "shot": "X2-B2",
   "who": "태진",
   "emo": "일반",
   "text": "전쟁이 집 안까지 들어온 거예요. 기차 자리는 전쟁에 쓰자. 포스터가 생활을 바꾸라고 한 거죠.",
   "sub": "전쟁이 생활 안으로 / 포스터가 생활을 바꾸라고",
   "start": 58.47,
   "end": 65.17,
   "words": []
  },
  {
   "part": "X2",
   "shot": "X2-B3",
   "who": "태진",
   "emo": "일반",
   "text": "이건 같은 해, 유나이티드 위 아 스트롱. 대포마다 연합국 국기. 여기서 유나이티드 네이션스는 연합국이란 뜻이었어요.",
   "sub": "\"United We Are Strong\" 1943 / 'United Nations' = 원래 연합국",
   "start": 65.59,
   "end": 74.24,
   "words": []
  },
  {
   "part": "X2",
   "shot": "X2-B3",
   "who": "옥자",
   "emo": "높은 톤",
   "text": "유엔이 원래 그 뜻이었어?",
   "sub": "유엔이 그 뜻?!",
   "start": 74.48,
   "end": 77.03,
   "words": []
  },
  {
   "part": "X2",
   "shot": "X2-B4",
   "who": "태진",
   "emo": "일반",
   "text": "천구백사십이 년 연합국 공동선언 이름이 유나이티드 네이션스였어요. 전쟁 끝나고 그 이름이 국제기구가 됐고, 오 년 뒤 유엔군이 한국에 와요.",
   "sub": "1942 연합국 공동선언 → 1945 국제연합 / 5년 뒤 한국의 유엔군",
   "start": 77.45,
   "end": 86.4,
   "words": []
  },
  {
   "part": "X3",
   "shot": "X3-C1",
   "who": "옥자",
   "emo": "일반",
   "text": "그럼 그다음이 삐라야?",
   "sub": "그다음이 삐라?",
   "start": 88.3,
   "end": 90.9,
   "words": []
  },
  {
   "part": "X3",
   "shot": "X3-C1",
   "who": "태진",
   "emo": "일반",
   "text": "포스터는 벽에 붙이잖아요. 적의 벽엔 못 붙이니까, 하늘에서 뿌린 거죠. 천구백사십오 년 미군이 일본군한테. 일미 휴전 성립, 전투를 중지하라.",
   "sub": "적의 벽엔 못 붙인다 → 하늘에서 뿌린다 / 1945 「日米休戦成立! 戦闘を中止せよ!」",
   "start": 91.14,
   "end": 102.09,
   "words": []
  },
  {
   "part": "X3",
   "shot": "X3-C2",
   "who": "태진",
   "emo": "일반",
   "text": "같은 해 팔월 사 일엔 우리말 신문 조선자유보가 하늘에서 떨어졌고요.",
   "sub": "1945. 8. 4 「조선자유보」",
   "start": 102.51,
   "end": 107.06,
   "words": []
  },
  {
   "part": "X3",
   "shot": "X3-C2",
   "who": "옥자",
   "emo": "기쁨",
   "text": "포스터가 날개를 단 거네.",
   "sub": "포스터가 날개를 달았다",
   "start": 107.3,
   "end": 109.2,
   "words": []
  },
  {
   "part": "X4",
   "shot": "X4-D1",
   "who": "태진",
   "emo": "일반",
   "text": "그리고 한국전쟁. 삼 년 동안 이십오억에서 사십억 장. 이번엔 종이마다 분석표가 붙어요. 대상, 목적, 번역.",
   "sub": "한국전쟁 3년 · 25억~40억 장 (추산) / 종이마다 분석표",
   "start": 111.1,
   "end": 119.3,
   "words": []
  },
  {
   "part": "X4",
   "shot": "X4-D2",
   "who": "태진",
   "emo": "기쁨",
   "text": "판화는 멋있게, 포스터는 짧게, 삐라는 누구한테 무슨 말을 할지 계산해서. 종이가 점점 똑똑해진 거죠.",
   "sub": "판화 = 멋있게 · 포스터 = 짧게 · 삐라 = 계산해서",
   "start": 119.72,
   "end": 126.07,
   "words": []
  },
  {
   "part": "X4",
   "shot": "X4-D2",
   "who": "옥자",
   "emo": "일반",
   "text": "종이가 공부를 했구먼.",
   "sub": "종이가 공부를 했다",
   "start": 126.31,
   "end": 129.16,
   "words": []
  },
  {
   "part": "X5",
   "shot": "X5-E1",
   "who": "옥자",
   "emo": "일반",
   "text": "그럼 전쟁 끝나고는?",
   "sub": "전쟁 끝나고는?",
   "start": 131.06,
   "end": 133.16,
   "words": []
  },
  {
   "part": "X5",
   "shot": "X5-E1",
   "who": "태진",
   "emo": "일반",
   "text": "다시 벽으로 돌아가요. 이건 육십 년대 북한 포스터 원화. 인쇄가 아니라 붓으로 그린 거예요.",
   "sub": "1960s 북한 포스터 — 인쇄가 아닌 손그림 원화",
   "start": 133.4,
   "end": 139.95,
   "words": []
  },
  {
   "part": "X5",
   "shot": "X5-E2",
   "who": "태진",
   "emo": "일반",
   "text": "이건 칠십 년대 중국 체육 포스터. 운동선수들이 행진하는데, 맨 앞 청년은 책을 읽고 있어요.",
   "sub": "1970s 중국 체육 포스터 / 행진 앞에서 책 읽는 청년",
   "start": 140.37,
   "end": 146.92,
   "words": []
  },
  {
   "part": "X5",
   "shot": "X5-E2",
   "who": "옥자",
   "emo": "기쁨",
   "text": "운동하면서 공부도 하라는 거네. 우리 엄마 잔소리네.",
   "sub": "운동하면서 공부도 = 엄마 잔소리",
   "start": 147.16,
   "end": 151.51,
   "words": []
  },
  {
   "part": "X5",
   "shot": "X5-E3",
   "who": "태진",
   "emo": "일반",
   "text": "이건 천구백육십삼 년 국제학생연맹 포스터. 지도 위에 날짜가 두 개 있어요. 천구백오십 년 유월 이십오 일, 천구백육십삼 년 유월 이십오 일.",
   "sub": "1963 국제학생연맹(IUS) 포스터 / 1950. 6. 25 · 1963. 6. 25",
   "start": 151.93,
   "end": 162.58,
   "words": []
  },
  {
   "part": "X5",
   "shot": "X5-E3",
   "who": "옥자",
   "emo": "일반",
   "text": "같은 육이오를 저렇게도 그렸구먼.",
   "sub": "같은 6·25, 다른 그림",
   "start": 162.82,
   "end": 165.42,
   "words": []
  },
  {
   "part": "X6",
   "shot": "X6-F1",
   "who": "태진",
   "emo": "일반",
   "text": "판화에서 포스터로, 포스터에서 삐라로, 다시 포스터로. 그리고 지금은 이거죠.",
   "sub": "판화 → 포스터 → 삐라 → 포스터 → 지금은?",
   "start": 167.32,
   "end": 173.77,
   "words": []
  },
  {
   "part": "X6",
   "shot": "X6-F1",
   "who": "옥자",
   "emo": "높은 톤",
   "text": "휴대폰?",
   "sub": "휴대폰?",
   "start": 174.01,
   "end": 175.26,
   "words": []
  },
  {
   "part": "X6",
   "shot": "X6-F2",
   "who": "태진",
   "emo": "기쁨",
   "text": "네. 짧게, 그림 한 장에, 누구한테 보낼지 계산해서. 백 년 전이랑 방법은 똑같아요.",
   "sub": "짧게 · 그림 한 장 · 받는 사람 계산 — 100년 전과 같다",
   "start": 175.68,
   "end": 181.18,
   "words": []
  },
  {
   "part": "X6",
   "shot": "X6-F2",
   "who": "옥자",
   "emo": "기쁨",
   "text": "그럼 나도 매일 삐라를 받는 거네. 알림으로.",
   "sub": "매일 받는 삐라 = 알림",
   "start": 181.42,
   "end": 185.42,
   "words": []
  },
  {
   "part": "X6",
   "shot": "X6-F3",
   "who": "태진",
   "emo": "기쁨",
   "text": "그래서 이 종이들을 모았어요. 티제이 김 컬렉션, 백 년 치 선전물. 다음엔 또 다른 종이로 올게요.",
   "sub": "TJ Kim Collection — 100년 치 선전물 / 다음 편에서",
   "start": 185.84,
   "end": 191.69,
   "words": []
  }
 ],
 "mock": false
}