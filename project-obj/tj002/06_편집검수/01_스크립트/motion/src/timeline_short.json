 "lines": [
  {
   "part": "S",
   "shot": "S01",
   "who": "옥자",
   "emo": "높은 톤",
   "text": "어머, 이거 삐라 아니야? 나 국민학교 때 이거 주워다 파출소 갖다주고 공책 받았는데!",
   "sub": "삐라 주워서 공책 받았다!",
   "start": 0.8,
   "end": 7.8,
   "words": []
  },
  {
   "part": "S",
   "shot": "S02",
   "who": "태진",
   "emo": "기쁨",
   "text": "맞아요. 삐라 신고하면 공책이랑 연필. 경찰 규칙에 진짜 있었어요. 이천칠 년에 없어졌고요.",
   "sub": "삐라 신고 = 공책 · 연필 / 경찰 규칙 · 2007년 폐지",
   "start": 8.22,
   "end": 14.77,
   "words": []
  },
  {
   "part": "S",
   "shot": "S03",
   "who": "옥자",
   "emo": "일반",
   "text": "근데 그 종이가 대체 어디서 그렇게 많이 떨어진 거야?",
   "sub": "그 많은 종이, 어디서 온 거야?",
   "start": 15.19,
   "end": 20.39,
   "words": []
  },
  {
   "part": "S",
   "shot": "S04",
   "who": "태진",
   "emo": "일반",
   "text": "한국전쟁 삼 년 동안 유엔군이 뿌린 삐라가 이십오억에서 사십억 장. 폭탄 탄피 하나에 이만 이천오백 장씩 넣어서 하늘에서 터뜨렸어요.",
   "sub": "한국전쟁 3년 · 25억~40억 장 / 탄피 1개 = 22,500장",
   "start": 20.81,
   "end": 31.16,
   "words": []
  },
  {
   "part": "S",
   "shot": "S05",
   "who": "옥자",
   "emo": "높은 톤",
   "text": "종이 폭탄이네, 종이 폭탄!",
   "sub": "종이 폭탄!",
   "start": 31.58,
   "end": 34.18,
   "words": []
  },
  {
   "part": "S",
   "shot": "S06",
   "who": "태진",
   "emo": "일반",
   "text": "미국 육군 장관이 그랬대요. 적을 삐라로 파묻어라. 이게 그때 삐라예요. 안전보장증서. 이거 들고 오면 안전 보장.",
   "sub": "\"적을 삐라로 파묻어라\" / 안전보장증서: 들고 오면 안전 보장",
   "start": 34.6,
   "end": 42.6,
   "words": []
  },
  {
   "part": "S",
   "shot": "S07",
   "who": "옥자",
   "emo": "높은 톤",
   "text": "어머, 이건 영어네? 오, 왓 어 뷰티풀 모닝?",
   "sub": "영어로 Oh! What a Beautiful Morning?",
   "start": 43.02,
   "end": 46.87,
   "words": []
  },
  {
   "part": "S",
   "shot": "S08",
   "who": "태진",
   "emo": "기쁨",
   "text": "북한 쪽에서 미군한테 뿌린 거예요. 아침마다 가족 생각하라고. 그리고 이건, 너 때문에 가족이 울게 하지 마라.",
   "sub": "북한 → 미군 삐라 / \"가족 생각해라\" · Don't Let Your Loved Ones Mourn",
   "start": 47.29,
   "end": 54.09,
   "words": []
  },
  {
   "part": "S",
   "shot": "S09",
   "who": "옥자",
   "emo": "기쁨",
   "text": "아이고, 서로 집에 가라고 종이로 싸웠구먼.",
   "sub": "서로 \"집에 가라\"고 종이로 싸웠네",
   "start": 54.51,
   "end": 58.21,
   "words": []
  },
  {
   "part": "S",
   "shot": "S10",
   "who": "태진",
   "emo": "일반",
   "text": "전쟁 끝나곤 풍선으로 바꿨고, 이모가 공책 받던 그 삐라가 그거예요. 이천 년에 정부는 멈췄는데, 이천이십사 년엔 풍선에 쓰레기가 왔죠.",
   "sub": "1955 풍선 → 1970s 공책 → 2000 중단 → 2024 오물풍선",
   "start": 58.63,
   "end": 67.58,
   "words": []
  },
  {
   "part": "S",
   "shot": "S11",
   "who": "옥자",
   "emo": "일반",
   "text": "요즘 애들은 삐라 주워도 공책 안 주지?",
   "sub": "요즘은 주워도 공책 안 줘?",
   "start": 68.0,
   "end": 71.15,
   "words": []
  },
  {
   "part": "S",
   "shot": "S12",
   "who": "태진",
   "emo": "기쁨",
   "text": "안 줘요. 대신 티제이 김 컬렉션에 백 장 넘게 모아 뒀어요. 뒷면 이야기는 롱폼에서.",
   "sub": "TJ Kim Collection 삐라 100장+ / 롱폼에서 계속",
   "start": 71.57,
