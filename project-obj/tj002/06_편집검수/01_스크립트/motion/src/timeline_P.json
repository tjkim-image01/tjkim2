 "lines": [
  {
   "part": "P",
   "shot": "P-S01",
   "who": "옥자",
   "emo": "높은 톤",
   "text": "이건 만화책이네? 주황색 만화.",
   "sub": "주황색 만화?",
   "start": 0.8,
