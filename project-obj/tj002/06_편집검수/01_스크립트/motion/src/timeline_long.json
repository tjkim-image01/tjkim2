 "lines": [
  {
   "part": "P0",
   "shot": "P0-I1",
   "who": "옥자",
   "emo": "높은 톤",
   "text": "어머 태진아, 이거 삐라잖아! 나 이거 국민학교 때 많이 주웠는데.",
   "sub": "이거 삐라잖아!",
   "start": 0.8,
   "end": 6.7,
   "words": []
  },
  {
   "part": "P0",
   "shot": "P0-I1",
   "who": "태진",
   "emo": "일반",
   "text": "역시 이모. 그때 주워서 어떻게 했어요?",
   "sub": "주워서 어떻게 했어요?",
   "start": 6.94,
   "end": 10.64,
   "words": []
  },
  {
   "part": "P0",
   "shot": "P0-I2",
   "who": "옥자",
   "emo": "기쁨",
   "text": "파출소! 갖다주면 공책 주고 연필 주고. 많이 가져가면 자도 줬어.",
   "sub": "파출소 가면 공책 · 연필 · 자",
   "start": 11.06,
   "end": 16.81,
   "words": []
  },
  {
   "part": "P0",
   "shot": "P0-I2",
   "who": "태진",
   "emo": "일반",
   "text": "그거 진짜 경찰 규칙이었어요. 북한 불온선전물 수거 처리 규칙. 이천칠 년에 없어졌어요. 주워 오는 애가 없어서.",
   "sub": "'북한 불온선전물 수거 처리 규칙' / 2007년 폐지 — 주워 오는 아이가 없어서",
   "start": 17.05,
   "end": 23.4,
   "words": []
  },
  {
   "part": "P0",
   "shot": "P0-I3",
   "who": "옥자",
   "emo": "일반",
   "text": "근데 그 종이가 대체 어디서 그렇게 떨어진 거야?",
   "sub": "그 종이, 어디서 떨어진 거야?",
   "start": 23.82,
   "end": 29.12,
   "words": []
  },
  {
   "part": "P0",
   "shot": "P0-I3",
   "who": "태진",
   "emo": "일반",
   "text": "그 얘기 하려면 천구백오십 년, 하늘부터 봐야 돼요.",
   "sub": "1950년, 하늘부터",
   "start": 29.36,
   "end": 33.41,
   "words": []
  },
  {
   "part": "P1",
   "shot": "P1-A1",
   "who": "태진",
   "emo": "일반",
   "text": "한국전쟁 삼 년 동안 유엔군이 뿌린 삐라가 최소 이십오억 장, 많게는 사십억 장이래요.",
   "sub": "한국전쟁 3년 · 25억~40억 장 (추산)",
   "start": 35.31,
   "end": 41.71,
   "words": []
  },
  {
   "part": "P1",
   "shot": "P1-A1",
   "who": "옥자",
   "emo": "높은 톤",
   "text": "사십억? 그때 남북 다 합쳐도 삼천만쯤이었을 텐데?",
   "sub": "40억 장?!",
   "start": 41.95,
   "end": 46.8,
   "words": []
  },
  {
   "part": "P1",
   "shot": "P1-A2",
   "who": "태진",
   "emo": "일반",
   "text": "사람 수의 백 배 가까운 거죠. 미국 육군 장관이 그랬대요. 적을 삐라로 파묻어라.",
   "sub": "사람 수의 100배 / \"적을 삐라로 파묻어라\"",
   "start": 47.22,
   "end": 52.67,
   "words": []
  },
  {
   "part": "P1",
   "shot": "P1-A2",
   "who": "옥자",
   "emo": "기쁨",
   "text": "말은 잘하네.",
   "sub": "말은 잘하네",
   "start": 52.91,
   "end": 54.36,
   "words": []
  },
  {
   "part": "P1",
   "shot": "P1-A3",
   "who": "태진",
   "emo": "일반",
   "text": "뿌리는 법도 세 가지. 비 이십구 폭격기로 삐라 폭탄 떨어뜨리고, 작은 비행기에서 손으로 뿌리고, 대포알에 넣어서 쏘고.",
   "sub": "① B-29 삐라 폭탄 ② 손 살포 ③ 포탄",
   "start": 54.78,
   "end": 63.83,
   "words": []
  },
  {
   "part": "P1",
   "shot": "P1-A3",
   "who": "태진",
   "emo": "일반",
   "text": "오백 파운드 폭탄 탄피 하나에 이만 이천오백 장. 하늘에서 터지면 눈처럼 내려와요.",
   "sub": "500파운드 탄피 1개 = 22,500장",
   "start": 64.07,
   "end": 70.82,
   "words": []
  },
  {
   "part": "P1",
   "shot": "P1-A3",
   "who": "옥자",
   "emo": "일반",
   "text": "종이 폭탄이네. 맞아도 안 아픈 폭탄.",
   "sub": "종이 폭탄 — 맞아도 안 아픈 폭탄",
   "start": 71.06,
   "end": 74.71,
   "words": []
  },
  {
   "part": "P1",
   "shot": "P1-A4",
   "who": "태진",
   "emo": "일반",
   "text": "삐라란 말은 영어 빌, 전단이란 뜻이 일본 거쳐서 삐라가 된 거예요. 표준어는 전단.",
   "sub": "삐라 = bill → ビラ → 삐라 (표준어: 전단)",
   "start": 75.13,
   "end": 81.53,
   "words": []
  },
  {
   "part": "P2",
   "shot": "P2-B1",
   "who": "태진",
   "emo": "일반",
   "text": "이게 제일 많이 뿌린 종류예요. 안전보장증서. 유엔군 사령관 이름으로, 이거 들고 오면 안전 보장한다.",
   "sub": "안전보장증서 (Safe Conduct Pass)",
   "start": 83.43,
   "end": 89.53,
   "words": []
  },
  {
   "part": "P2",
   "shot": "P2-B1",
   "who": "옥자",
   "emo": "일반",
   "text": "비행기표 같네. 이거 들고 가면 진짜 받아줬어?",
   "sub": "이거 들고 가면 받아줘?",
   "start": 89.77,
   "end": 94.02,
   "words": []
  },
  {
   "part": "P2",
   "shot": "P2-B2",
   "who": "태진",
   "emo": "일반",
   "text": "그러려고 만든 거죠. 그리고 이런 것도 있어요. 아버지는 어데 게세요. 추석은 왔건마는 고향은 멀고멀다.",
   "sub": "'아버지는 어데 게세요?' / '추석은 왔건마는 고향은 멀고멀다'",
   "start": 94.44,
   "end": 102.04,
   "words": []
  },
  {
   "part": "P2",
   "shot": "P2-B2",
   "who": "옥자",
   "emo": "슬픔",
   "text": "아이고, 이건 좀 찡하다. 집 생각나라고 쓴 거구먼.",
   "sub": "집 생각나라고 쓴 거구먼",
   "start": 102.28,
   "end": 107.43,
   "words": []
  },
  {
   "part": "P2",
   "shot": "P2-B3",
   "who": "태진",
   "emo": "일반",
   "text": "분석 보고서에 그렇게 적혀 있어요. 지친 군인한텐 겁주는 것보다 향수가 잘 먹힌다고.",
   "sub": "미군 분석: \"겁주기보다 향수가 잘 먹힌다\"",
   "start": 107.85,
   "end": 113.5,
   "words": []
  },
  {
   "part": "P2",
   "shot": "P2-B3",
   "who": "태진",
   "emo": "일반",
   "text": "이 컬렉션 삐라들은 뒤에 미군 분석표가 붙어 있어요. 언어, 대상, 번역, 전부 영어로. 삐라마다 성적표가 있는 셈이죠.",
   "sub": "삐라마다 미군 분석표 = 성적표",
   "start": 113.74,
   "end": 122.24,
   "words": []
  },
  {
   "part": "P2",
   "shot": "P2-B3",
   "who": "옥자",
   "emo": "기쁨",
   "text": "종이 한 장에 성적표까지. 꼼꼼하네.",
   "sub": "성적표까지!",
   "start": 122.48,
   "end": 125.43,
   "words": []
  },
  {
   "part": "P3",
   "shot": "P3-C1",
   "who": "옥자",
   "emo": "높은 톤",
   "text": "어? 이건 영어네. 유즈 유어 헤드, 솔저? 머리를 써라?",
   "sub": "Use your head, soldier? 머리를 써라?",
   "start": 127.33,
   "end": 132.03,
   "words": []
  },
  {
   "part": "P3",
   "shot": "P3-C1",
   "who": "태진",
   "emo": "일반",
   "text": "북한이 미군한테 뿌린 거예요. 머리를 붙여 두고 싶으면 집에 가라, 이런 거죠.",
   "sub": "북한 → 미군: \"머리를 붙여 두고 싶으면 집에 가라\"",
   "start": 132.27,
   "end": 137.12,
   "words": []
  },
  {
   "part": "P3",
   "shot": "P3-C2",
   "who": "태진",
   "emo": "기쁨",
   "text": "이건 더 재밌어요. 오, 왓 어 뷰티풀 모닝. 뮤지컬 노래 제목이에요. 아침에 휘파람 불던 노래 기억나지? 가족 생각해라.",
   "sub": "'Oh! What a Beautiful Morning!' → 가족 생각해라",
   "start": 137.54,
   "end": 146.54,
   "words": []
  },
  {
   "part": "P3",
   "shot": "P3-C2",
   "who": "옥자",
   "emo": "기쁨",
   "text": "아이고, 서로 집에 가라고 종이로 싸웠구먼.",
   "sub": "서로 \"집에 가라\"고 종이 싸움",
   "start": 146.78,
   "end": 150.98,
   "words": []
  },
  {
   "part": "P3",
   "shot": "P3-C3",
   "who": "태진",
   "emo": "일반",
   "text": "맥아더 삐라도 있어요. 매일 밤 아홉 시, 구백오십 킬로사이클 방송을 들어라. 종이로 라디오 광고까지 한 거죠.",
   "sub": "맥아더 삐라: 매일 밤 9시 950kc 방송을 들어라",
   "start": 151.4,
   "end": 158.95,
   "words": []
  },
  {
   "part": "P3",
   "shot": "P3-C3",
   "who": "옥자",
   "emo": "일반",
   "text": "그 시절 유튜브 구독 눌러 달라는 거네.",
   "sub": "그 시절 '구독 눌러 주세요'",
   "start": 159.19,
   "end": 162.44,
   "words": []
  },
  {
   "part": "P4",
   "shot": "P4-D1",
   "who": "태진",
   "emo": "일반",
   "text": "전쟁이 끝나니까 비행기로는 못 뿌리잖아요. 천구백오십오 년에 백령도에서 풍선 실험을 해요. 풍선 사천 개.",
   "sub": "1955 백령도 풍선 실험 · 풍선 4,000개",
   "start": 164.34,
   "end": 172.14,
   "words": []
  },
  {
   "part": "P4",
   "shot": "P4-D1",
   "who": "옥자",
   "emo": "일반",
   "text": "그래서 우리 어릴 때 풍선 달린 삐라가 떨어졌구나.",
   "sub": "그래서 풍선 달린 삐라가…",
   "start": 172.38,
   "end": 176.33,
   "words": []
  },
  {
   "part": "P4",
   "shot": "P4-D2",
   "who": "태진",
   "emo": "일반",
   "text": "남쪽도 북쪽도 서로 뿌렸어요. 팔십 년대엔 남쪽이 여배우 사진이랑 잡지, 워크맨까지 꾸러미로 보냈대요.",
   "sub": "1980년대: 여배우 사진 · 잡지 · 워크맨 꾸러미",
   "start": 176.75,
   "end": 184.0,
   "words": []
  },
  {
   "part": "P4",
   "shot": "P4-D2",
   "who": "옥자",
   "emo": "높은 톤",
   "text": "워크맨을? 그건 나도 못 가졌는데!",
   "sub": "워크맨을?!",
   "start": 184.24,
   "end": 187.79,
   "words": []
  },
  {
   "part": "P4",
   "shot": "P4-D3",
   "who": "태진",
   "emo": "기쁨",
   "text": "그래서 아이들이 주워 오면 공책 주고 연필 주고. 이모가 받은 공책이 그 전쟁의 마지막 조각이에요.",
   "sub": "아이들의 공책 = 그 전쟁의 마지막 조각",
   "start": 188.21,
   "end": 195.31,
   "words": []
  },
  {
   "part": "P4",
   "shot": "P4-D3",
   "who": "옥자",
   "emo": "일반",
   "text": "그러고 보니 그 공책에 받아쓰기 했네.",
   "sub": "그 공책에 받아쓰기 했지",
   "start": 195.55,
   "end": 198.85,
   "words": []
  },
  {
   "part": "P5",
   "shot": "P5-E1",
   "who": "태진",
