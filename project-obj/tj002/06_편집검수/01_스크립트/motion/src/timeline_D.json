   "words": []
  },
  {
   "part": "D",
   "shot": "D-S03",
   "who": "옥자",
   "emo": "일반",
   "text": "빨간 거 파란 거 두 가지네.",
   "sub": "빨강 · 파랑 두 가지",
   "start": 12.94,
