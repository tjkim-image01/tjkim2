 "lines": [
  {
   "part": "M",
   "shot": "M-S01",
   "who": "옥자",
   "emo": "높은 톤",
   "text": "공습예고? 폭격한다고 미리 알려 줬다는 거야?",
   "sub": "공습예고?!",
   "start": 0.8,
