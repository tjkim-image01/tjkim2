[
  {
    "start": 2.2,
    "end": 3.332,
    "text": "K팝보다 먼저,"
  },
  {
    "start": 3.332,
    "end": 4.6111,
    "text": "조선을 세계에 알린"
  },
  {
    "start": 4.6111,
    "end": 6.0372,
    "text": "그림이 있었습니다."
  },
  {
    "start": 6.0372,
    "end": 7.9043,
    "text": "미술 한류의 원조라 불리는,"
  },
  {
    "start": 7.9043,
    "end": 9.9184,
    "text": "기산 김준근의 풍속화입니다."
  },
  {
    "start": 12.0,
    "end": 12.9029,
    "text": "그 흐름을 잇는"
  },
  {
    "start": 12.9029,
    "end": 14.3447,
    "text": "작가로 전해지는 운초."
  },
  {
    "start": 14.3447,
    "end": 15.2476,
    "text": "이 그림에는,"
  },
  {
    "start": 15.2476,
    "end": 16.5547,
    "text": "한 사람의 마지막 길을"
  },
  {
    "start": 16.5547,
    "end": 18.2661,
    "text": "함께하는 이들이 있습니다."
  },
  {
    "start": 20.2,
    "end": 21.6529,
    "text": "짚으로 덮은 상여와"
  },
  {
    "start": 21.6529,
    "end": 22.4378,
    "text": "긴 멜대."
  },
  {
    "start": 22.4378,
    "end": 23.8907,
    "text": "관을 어깨에 메고,"
  },
  {
    "start": 23.8907,
    "end": 25.3436,
    "text": "장지로 향합니다."
  },
  {
    "start": 28.0,
    "end": 29.9009,
    "text": "낯선 조선에 온 외국인들은,"
  },
  {
    "start": 29.9009,
    "end": 31.6522,
    "text": "사람들의 옷차림과 생활,"
  },
  {
    "start": 31.6522,
    "end": 33.4034,
    "text": "의례를 궁금해했습니다."
  },
  {
    "start": 33.4034,
    "end": 34.5559,
    "text": "이런 풍속화는,"
  },
  {
    "start": 34.5559,
    "end": 36.7562,
    "text": "그 문화를 전하는 창이었습니다."
  },
  {
    "start": 39.0,
    "end": 40.1321,
    "text": "갓 아래의 얼굴과"
  },
  {
    "start": 40.1321,
    "end": 41.5582,
    "text": "길게 흐르는 옷자락."
  },
  {
    "start": 41.5582,
    "end": 42.8373,
    "text": "한 획씩 따라가면,"
  },
  {
    "start": 42.8373,
    "end": 44.9986,
    "text": "오래전 사람들의 마지막 배웅이,"
  },
  {
    "start": 44.9986,
    "end": 47.1598,
    "text": "오늘 우리 앞에 다시 나타납니다."
  },
  {
    "start": 51.5,
    "end": 52.1302,
    "text": "이 작품은"
  },
  {
    "start": 52.1302,
    "end": 53.2967,
    "text": "TJ KIM 컬렉션"
  },
  {
    "start": 53.2967,
    "end": 54.3292,
    "text": "소장품입니다."
  }
]
